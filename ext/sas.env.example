# https://docs.aws.amazon.com/cli/v1/userguide/cli-configure-envvars.html
AWS_ENDPOINT_URL=https://
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Optional public object URL bases. Unset or empty preserves the AWS endpoint URLs.
# The upload endpoint must address the same bucket; for this example set AWS_BUCKET=keychat-media.
# MEDIA_PUBLIC_UPLOAD_URL=https://keychat-media.s3-accelerate.amazonaws.com
# MEDIA_PUBLIC_BASE_URL=https://cdn.keychat.io

# Download acceleration only (same bucket as the ordinary upload endpoint):
# AWS_BUCKET=keychat-media
# AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
# MEDIA_PUBLIC_BASE_URL=https://keychat-media.s3-accelerate.amazonaws.com
# Leave MEDIA_PUBLIC_UPLOAD_URL unset.
