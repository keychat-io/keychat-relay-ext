# https://docs.aws.amazon.com/cli/v1/userguide/cli-configure-envvars.html
AWS_ENDPOINT_URL=https://
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Optional public object URL bases. Unset or empty preserves the AWS endpoint URLs.
# The upload endpoint must address the same bucket; for this example set AWS_BUCKET=example-bucket.
# MEDIA_PUBLIC_UPLOAD_URL=https://example-bucket.s3-accelerate.amazonaws.com
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com

# Download acceleration only (same bucket as the ordinary upload endpoint):
# AWS_BUCKET=example-bucket
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# MEDIA_PUBLIC_BASE_URL=https://example-bucket.s3-accelerate.amazonaws.com
# Leave MEDIA_PUBLIC_UPLOAD_URL unset.
